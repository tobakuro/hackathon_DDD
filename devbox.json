{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "git@latest",
    "go@latest",
    "golangci-lint@latest"
  ],
  "shell": {
    "init_hook": [
      "echo '🚀 Devbox shell に入りました'",
      "echo '📖 セットアップ手順は docs/1_setup_devbox.md を参照'",
      "echo '📖 サーバー起動手順は docs/2_setup.md を参照'",
      "echo '📖 よく使うコマンドは docs/commands.md を参照'",
      "[ -f server/go.mod ] && (cd server && go mod tidy) || true"
    ],
    "scripts": {
      "setup": [
        "echo '【TODO】依存インストールコマンドをここに記載 (例: pnpm install)'"
      ],
      "dev": [
        "echo '【TODO】開発サーバー起動コマンドをここに記載'"
      ],
      "build": [
        "go build ./api/... ./attacker/..."
      ],
      "test": [
        "go test ./api/... ./attacker/... -cover -coverprofile=coverage/coverage.out"
      ],
      "lint": [
        "golangci-lint run ./api/... ./attacker/..."
      ],
      "lint:fix": [
        "golangci-lint run --fix ./api/... ./attacker/..."
      ],
      "format": [
        "gofmt -w ./api ./attacker"
      ],
      "format:check": [
        "test -z \"$(gofmt -l ./api ./attacker)\" || (gofmt -l ./api ./attacker && exit 1)"
      ],
      "typecheck": [
        "go vet ./api/... ./attacker/..."
      ]
    }
  },
  "env": {
    "PROJECT_ROOT": "$PWD"
  }
}
