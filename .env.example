# プロジェクトで使用する環境変数のサンプル
# このファイルをコピーして .env を作成し、各値を設定してください
#
#   cp .env.example .env
#
# 🔒 .env は絶対にcommitしないでください

# ----------------------------------------------------------------
# ゲームサーバー設定
# ----------------------------------------------------------------

# サーバーのポート番号
SERVER_PORT=8080

# ----------------------------------------------------------------
# Docker設定
# ----------------------------------------------------------------

# ターゲットコンテナのリソース制限（攻略難易度）
TARGET_MEMORY_LIMIT=256m
TARGET_CPU_LIMIT=0.5

# 攻撃コンテナ1つあたりのリソース上限
ATTACKER_MEMORY_LIMIT=64m
ATTACKER_CPU_LIMIT=0.25

# ----------------------------------------------------------------
# ゲームバランス設定
# ----------------------------------------------------------------

# 制限時間（秒）
GAME_TIME_LIMIT_SEC=120

# 同時起動できる攻撃コンテナの最大数
MAX_ATTACKER_CONTAINERS=10
